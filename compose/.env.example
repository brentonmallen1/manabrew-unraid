# Copy to .env and fill in. Never commit .env.

# Shared relay key, your access control. Generate with: openssl rand -hex 32
MANABREW_SERVER_KEY=

# Public hostnames (both proxied by NPM)
RELAY_HOST=relay.example.com
PLAY_HOST=play.example.com

# Docker network NPM is on (must already exist: docker network create proxynet)
PROXY_NETWORK=proxynet

# All three images share version tags. Pin one (e.g. 3.65.0) to update on
# your schedule, or track latest (upstream releases several times a week)
MANABREW_TAG=latest

# Leave empty: friends paste the key in Settings > Server.
# Set to MANABREW_SERVER_KEY only if play.* is behind an NPM Access List.
WEB_RELAY_PASSWORD=

# Forge room pool: concurrent browser Forge games (~1 GB RAM per 4)
NODE_MAX_GAMES=3
NODE_MAX_PLAYERS=4
NODE_MEM_LIMIT=2g
NODE_ROOM_NAME=Forge Table

FORGE_MAX_ROOMS=20
FORGE_WASM=false
