# Copy to .env and fill in. Never commit .env.

# Shared relay key, your access control. Generate with: openssl rand -hex 32
MANABREW_SERVER_KEY=

# Public hostnames (both proxied by NPM)
RELAY_HOST=relay.example.com
PLAY_HOST=play.example.com

# Ports published on the Unraid host; point NPM's proxy hosts at UNRAID-IP:port.
# Change them if something else on the server already uses 8095 or 9443.
WEB_HOST_PORT=8095
RELAY_HOST_PORT=9443

# All three images share version tags. Pin one (e.g. 3.65.0) to update on
# your schedule, or track latest (upstream releases several times a week)
MANABREW_TAG=latest

# Written in plain text into play.*'s public /config.js.
# With an NPM Access List on play.*: set to the same value as MANABREW_SERVER_KEY
#   (needed for browser Forge "Play vs AI", which ignores the key typed in Settings).
# Without one: leave empty; friends paste the key in Settings > Server.
WEB_RELAY_PASSWORD=

# Forge room pool: concurrent browser Forge games (~1 GB RAM per 4)
NODE_MAX_GAMES=3
NODE_MAX_PLAYERS=4
NODE_MEM_LIMIT=2g
NODE_ROOM_NAME=Forge Table

FORGE_MAX_ROOMS=20
FORGE_WASM=false
